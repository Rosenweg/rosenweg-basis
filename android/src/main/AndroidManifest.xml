<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Anmeldung und Haupt-API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- DNS-Server des aktiven Netzes (Erkennung "im Haus") -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Rosenweg-Karte lesen (Anmeldeschirm und NfcKarte.kt); Handys ohne NFC bleiben erlaubt -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Geteilte Telefone: Rosenweg Geraet (AnlageProvider, nur Rosenweg-Signatur).
         Wie im Cloud-Modul von commons-rosenweg. -->
    <uses-permission android:name="ch.rosenweg4303.permission.ANLAGE" />
    <queries>
        <provider android:authorities="ch.rosenweg4303.telefon.anlage" />
        <!-- Browser fuer die Anmeldeseite (url_launcher, Android 11+) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <!-- Geplante Benachrichtigungen (Benachrichtigung.planen) nach einem Neustart wieder einplanen -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application>
        <!-- flutter_local_notifications: geplante Benachrichtigungen (z. B. Erinnerung
             Waschkueche 15 Minuten vor dem Start). POST_NOTIFICATIONS bringt das Plugin mit. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- Ruecksprung der Browser-Anmeldung (<applicationId>:/anmeldung) und Anmeldeschirm
             kommen aus commons-rosenweg (cloud): RosenwegAnmeldungActivity, RosenwegAnmeldeSchirm. -->
    </application>
</manifest>
