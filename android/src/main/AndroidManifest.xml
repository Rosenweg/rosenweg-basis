<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Anmeldung und Haupt-API -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- DNS-Server des aktiven Netzes (Erkennung "im Haus") -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Geteilte Telefone: Rosenweg Geraet (AnlageProvider, nur Rosenweg-Signatur).
         Wie im Cloud-Modul von commons-rosenweg. -->
    <uses-permission android:name="ch.rosenweg4303.permission.ANLAGE" />
    <queries>
        <provider android:authorities="ch.rosenweg4303.telefon.anlage" />
        <!-- Browser fuer die Anmeldeseite (url_launcher, Android 11+) -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application>
        <!-- Ruecksprung der Browser-Anmeldung (<applicationId>:/anmeldung) und Anmeldeschirm
             kommen aus commons-rosenweg (cloud): RosenwegAnmeldungActivity, RosenwegAnmeldeSchirm. -->
    </application>
</manifest>
